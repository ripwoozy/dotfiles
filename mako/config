# ~/.config/mako/config

include=~/.cache/wal/mako

font=JetBrainsMono Nerd Font 10
anchor=top-right
default-timeout=4000
border-size=2
border-radius=10
padding=12
width=320
height=110
margin=12
icons=1
max-icon-size=48
layer=overlay

[urgency=high]
default-timeout=0

[app-name=wp-vol]
anchor=bottom-center
layer=overlay
history=0
group-by=app-name
format=<b>%s</b>
text-alignment=center
default-timeout=1000
outer-margin=0,0,40,0

[app-name=brightness-osd]
anchor=bottom-center
layer=overlay
history=0
group-by=app-name
format=<b>%s</b>
text-alignment=center
default-timeout=1000
outer-margin=0,0,40,0