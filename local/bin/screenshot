#!/bin/bash
# Author: ripwoozy
set -euo pipefail

PICTURES_FOLDER="$HOME/Pictures"
SCREENSHOTS_FOLDER="$PICTURES_FOLDER/Screenshots"

mkdir -p "$SCREENSHOTS_FOLDER"

DATE=$(date +"%d-%m-%Y_%H-%M-%S")
FILENAME="screenshot-$DATE.png"
FILEPATH="$SCREENSHOTS_FOLDER/$FILENAME"

check_dep() {
    command -v "$1" >/dev/null 2>&1 || {
        notify-send "Screenshot Error" "$1 is not installed!"
        exit 1
    }
}

check_dep grim
check_dep notify-send

MODE="${1:-full}"

case "$MODE" in
    monitor)
        check_dep hyprctl
        check_dep jq
        OUTPUT="$(hyprctl monitors -j | jq -r '.[] | select(.focused==true).name')"
        [ -n "$OUTPUT" ] || exit 1
        grim -o "$OUTPUT" "$FILEPATH"
        ;;
    *)
        grim "$FILEPATH"
        ;;
esac

if command -v wl-copy >/dev/null 2>&1; then
    wl-copy < "$FILEPATH"
fi

notify-send "📸 Screenshot Taken" "$FILENAME" -i "$FILEPATH"
echo "Saved to: $FILEPATH"